# Production backend template only. Store real values in the hosting secret UI.
# For local Docker testing, copy to ignored .env.production and chmod 600 it.
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_SECRET_KEY=replace-with-a-new-random-production-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=your-backend.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require
ARTWORK_GATEWAY_URL=https://kaan-gallery-r2-gateway.kaan-gallery-r2-gateway.workers.dev
ARTWORK_GATEWAY_TOKEN=replace-with-the-existing-worker-storage-token
# Set true only after verifying Render's ingress sanitizes forwarded headers.
DJANGO_TRUST_PROXY_HEADERS=false
PORT=8000
